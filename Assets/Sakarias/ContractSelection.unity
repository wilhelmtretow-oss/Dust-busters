  m_Script: {fileID: 11500000, guid: 075a1145986d8fa489cab98d784c826c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HelpAdvance
  helpText: {fileID: 1481648546}
  dialogueLines:
  - Here is where you get to select contracts! You can see the place and how difficult
    it'll be.
  - Keep in mind... If you break anything, I'll take that out of your paycheck! So
    you better be careful...
  - Don't get scared once you open the door. I'll only let you go once you cleaned
    around 70% but you wont get all the money for it.
  - Once the timer goes below one minute, BUST FASTER!!
  - Oh, if you need to buy anything or equip items from the shop. You can do that
    here aswell.
  currentText: {fileID: 1461691797}

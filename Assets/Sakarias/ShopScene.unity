  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HelpAdvance
  helpText: {fileID: 1202196399}
  dialogueLines:
  - Hello, Buster! I have the only legal wares in the world in my BelsaShop.
  - You can buy everything from new machines to damage boosts in here, Buster. Once
    you buy your items I will let you use them until you die.
  - All products are certified by Anti-Clean Coalition, which is a perfectly trustworthy
    authority, Buster.
  - Every item has a history, Buster. Some even remember their previous owners.
  - Refunds are not availabe. Not since the incident. You were not there, Buster.
    You are fortunate.
  currentText: {fileID: 2011358334}
